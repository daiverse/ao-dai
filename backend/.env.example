PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aodai?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# PayOS Payment Gateway Credentials
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# Email System — Mail A: Support (Gửi form thông báo đơn hàng đến Admin)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_support_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM="DaiVerse Support System" <your_support_email@gmail.com>

# Email System — Mail B: Admin (Gửi Email Cảm Ơn từ admin@daiverse.com.vn đến Khách Hàng)
ADMIN_EMAIL=admin@daiverse.com.vn
ADMIN_EMAIL_HOST=mail.daiverse.com.vn
ADMIN_EMAIL_PORT=587
ADMIN_EMAIL_PASS=your_admin_email_password_here

# Hugging Face Access Token for AI Design & Models
HF_TOKEN=your_huggingface_access_token_here
